# Normalize line endings so a clone on any platform matches.
* text=auto eol=lf

# Windows scripts must keep CRLF-tolerant handling but stay LF in the repo;
# PowerShell reads either form.
*.ps1 text eol=lf
*.sh text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
