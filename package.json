{
    "name":  "dsh-sensitive-guard",
    "version":  "3.0.0",
    "description":  "Pre-gateway sensitive content guard for DeepSeek Harness. Masks secrets, PII, credentials, one-time codes and high-entropy keys on both request and response, reads text and QR from images, redacts irreversibly. Default mask-and-pass, optional strict block.",
    "type":  "module",
    "license":  "MIT",
    "author":  "XGuai-S",
    "homepage":  "https://github.com/XGuai-S/dsh-sensitive-guard#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/XGuai-S/dsh-sensitive-guard.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/XGuai-S/dsh-sensitive-guard/issues"
             },
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./selfcheck":  "./ocr/selfcheck.mjs"
                },
    "files":  [
                  "index.js",
                  "ocr",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "docs",
                  "test",
                  "icon.svg",
                  "README.md",
                  "README.zh.md",
                  "README.en.md",
                  "LICENSE"
              ],
    "keywords":  [
                     "dsh-plugin",
                     "dsh",
                     "deepseek-harness",
                     "security",
                     "redaction",
                     "dlp",
                     "ocr",
                     "pii",
                     "secrets"
                 ],
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "test":  "node test/regression.mjs",
                    "selfcheck":  "node ocr/selfcheck.mjs"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "dependencies":  {
                         "jsqr":  "^1.4.0"
                     }
}